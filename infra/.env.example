# =============================================================================
# Auditi — Environment Variables
# Kopiere diese Datei nach ../.env und fülle die Werte aus.
# =============================================================================

# Datenbank (RDS PostgreSQL auf OTC)
DATABASE_URL=postgresql://USER:PASS@1da53191c935478bb43c8484b5949d55in03.internal.eu-de.postgresql.rds.otc.t-systems.com:5432/auditi_db

# OTC OBS (S3-kompatibler Objektspeicher)
OBS_ACCESS_KEY=
OBS_SECRET_KEY=
OBS_BUCKET=auditi-app

# NextAuth.js v5
# NEXTAUTH_URL: öffentliche URL der App (kein trailing slash)
NEXTAUTH_URL=http://80.158.39.186:3100
# Generieren mit: openssl rand -base64 32
NEXTAUTH_SECRET=

# Token-Sicherheit für Response-Portal
# Generieren mit: openssl rand -base64 32
RESPONSE_TOKEN_SECRET=

# Brevo SMTP (ehemals Sendinblue)
BREVO_LOGIN=deine@email.de
BREVO_SMTP_KEY=

# Redis (intern im Docker-Netzwerk — nicht ändern wenn Docker Compose genutzt wird)
REDIS_URL=redis://auditi-redis:6379

# Seed-Admin (nur für scripts/seed-admin.ts)
ADMIN_EMAIL=admin@kanzlei.de
ADMIN_PASSWORD=changeme123!
ADMIN_NAME=Administrator
